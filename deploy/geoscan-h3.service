[Unit]
Description=Geoscan H3 mission workspace
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=geoscan-h3
Group=geoscan-h3
WorkingDirectory=/opt/geoscan-h3/app
EnvironmentFile=/etc/geoscan-h3/environment
Environment=PYTHONPATH=/opt/geoscan-h3/app/src:/opt/geoscan-h3/h1/src:/opt/geoscan-h3/h2/src
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME=/var/lib/geoscan-h3
Environment=XDG_CACHE_HOME=/var/lib/geoscan-h3/cache
ExecStart=/opt/geoscan-h3/venv/bin/python -m uvicorn gmp.api.app:app --host 127.0.0.1 --port 8090 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillMode=mixed
StateDirectory=geoscan-h3
StateDirectoryMode=0750
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/geoscan-h3
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=3G
TasksMax=128

[Install]
WantedBy=multi-user.target
